    {
      "id": "cancel-done",
      "from": "cancel-inflight",
      "to": "task-cancelled",
      "label": "取消完成",
      "labelAt": [
        556,
        356
      ]
    },
    {
      "id": "provider-failed",
      "from": "provider-wait",
      "to": "task-failed",
      "label": "不可恢复错误",
      "labelAt": [
        402,
        356
      ]
    },
    {
      "id": "children-succeeded",
      "from": "children-wait",
      "to": "task-succeeded",
      "label": "全部成功"
    }
