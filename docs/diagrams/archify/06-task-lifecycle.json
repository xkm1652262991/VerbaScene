  "cards": [
    {
      "dot": "emerald",
      "title": "领取与等待",
      "items": [
        "原子领取后执行；远端受理后等待并轮询。",
        "父任务可直接创建为 waiting_children。"
      ]
    },
    {
      "dot": "amber",
      "title": "重启与重试",
      "items": [
        "过期租约才恢复；提交未知则失败。",
        "明确未提交可重试；人工重试创建新任务。"
      ]
    },
    {
      "dot": "rose",
      "title": "其他终态分支",
      "items": [
        "排队取消直接终止；运行错误可直接失败。",
        "父任务汇总子任务；终态清空去重键与租约。"
      ]
    }
  ]
