  "cards": [
    {
      "dot": "cyan",
      "title": "两次独立的创作动作",
      "items": [
        "分镜任务读取当前剧本、实体与资产快照，由用户主动发起。",
        "上下两行分别是剧本与分镜任务；不是同一次自动串行任务。"
      ]
    },
    {
      "dot": "emerald",
      "title": "保留有效稿与完整轨迹",
      "items": [
        "无需修订时直接采用初稿；审稿不可用或 Patch 无效时保留有效稿。",
        "初稿解析失败仅尝试结构恢复；每次模型调用前后持久化检查点。"
      ]
    },
    {
      "dot": "violet",
      "title": "合同约束与可编辑结果",
      "items": [
        "分镜最终合同无效则任务失败，旧批次保持不变。",
        "分镜输出进入可编辑工作台；后续 Prompt 重编译由用户发起。"
      ]
    }
