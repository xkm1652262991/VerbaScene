      "sublabel": "版本 / 参数 / 首帧",
      "width": 170,
      "height": 72
    },
    {
      "id": "video-candidate",
      "lane": "video",
      "col": 2,
      "type": "database",
      "label": "视频候选",
      "sublabel": "模型视频与原生音轨",
      "width": 170,
      "height": 72
