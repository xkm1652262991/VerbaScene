  "cards": [
    {
      "dot": "cyan",
      "title": "生成与返工",
      "items": [
        "每行是用户独立发起的生产动作；上一行采用版本成为下一行输入。",
        "可单独重生成状态、图片或片段；上传可直入资产；旧版本保留。"
      ]
    },
    {
      "dot": "emerald",
      "title": "视频输入合同",
      "items": [
        "主路径使用角色 / 场景参考图 + 文本；首帧必须显式选择。",
        "上游编辑只标记 Prompt 过期；人工稿由用户主动重编译。"
      ]
    },
    {
      "dot": "violet",
      "title": "音轨与字幕",
      "items": [
        "保留原生音轨；无音轨片段补等长静音。",
        "字幕时间：人工 > 可选 ASR > 确定性规则；ASR 不改对白文本。"
      ]
    }
  ]
