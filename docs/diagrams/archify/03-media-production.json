{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "VerbaScene · 媒体生产与成片导出",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "assets",
      "label": "资产参考图"
    },
    {
      "id": "video",
      "label": "视频片段"
    },
    {
      "id": "export",
      "label": "成片导出"
    }
  ],
  "mainPath": [
    "entity-spec",
    "image-request",
    "image-candidate",
    "image-selected"
