    {
      "id": "video-request-to-video-candidate",
      "from": "video-request",
      "to": "video-candidate",
      "label": "Adapter 执行",
      "variant": "emphasis"
    },
    {
      "id": "video-candidate-to-video-selected",
      "from": "video-candidate",
      "to": "video-selected",
      "label": "人工采用",
      "variant": "emphasis"
    },
    {
      "id": "export-snapshot-to-normalize-clips",
      "from": "export-snapshot",
      "to": "normalize-clips",
      "label": "冻结版本",
      "variant": "emphasis"
    },
    {
      "id": "normalize-clips-to-subtitle-compose",
      "from": "normalize-clips",
      "to": "subtitle-compose",
      "label": "标准化片段",
      "variant": "emphasis"
    },
    {
      "id": "subtitle-compose-to-final-export",
      "from": "subtitle-compose",
      "to": "final-export",
      "label": "写入成片",
      "variant": "emphasis"
    }
