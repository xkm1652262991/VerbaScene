  "cards": [
    {
      "dot": "cyan",
      "title": "资源身份",
      "items": [
        "槽位 = 项目 + 资产类型 / 用途 + 实体 + variant_key。",
        "variant_key 表示剧情状态；version 表示同一槽位的重生成次数。"
      ]
    },
    {
      "dot": "emerald",
      "title": "来源与引用",
      "items": [
        "source_task_id / source_script_id / source_shot_batch_id 贯穿产物。",
        "视频与导出任务冻结精确媒体版本、有序引用与参数。"
      ]
    },
    {
      "dot": "violet",
      "title": "版本规则",
      "items": [
        "promote 创建正式资产；select 改当前选择；旧版本保留。",
        "上传可直接入正式资产；图示为模型候选主链路，非完整 ER 图。"
      ]
