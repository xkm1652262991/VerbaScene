  "cards": [
    {
      "dot": "cyan",
      "title": "工作台与业务边界",
      "items": [
        "三个工作区自由导航；任务中心查询实际进度。",
        "候选经人工采用成为正式版本；上游变更仅提示 Prompt 过期。",
        "图中服务和 Worker 属于同一 API 进程。"
      ]
    },
    {
      "dot": "emerald",
      "title": "运行与持久化",
      "items": [
        "GenerationTask 是任务真相源；进程内事件仅唤醒。",
        "文本默认并发 2、可配 1–4；图片 / 视频最高 2；媒体 1。",
        "原生本地使用 SQLite；Compose 默认 PostgreSQL 17。"
      ]
    },
    {
      "dot": "violet",
      "title": "模型与交付",
      "items": [
        "能力协商决定参考输入、时长、分辨率与原生音频。",
        "模型生成媒体先进入候选；FFmpeg 按采用版本导出。",
        "当前为单 API 进程部署；认证、多实例和对象存储待演进。"
      ]
    }
  ]
