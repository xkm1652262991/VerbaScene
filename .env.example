APP_NAME=VerbaScene API
APP_VERSION=0.1.0
APP_ENV=local
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# 原生开发可使用 storage/local/content.sqlite3；Docker Compose 默认使用 PostgreSQL。
PERSISTENCE_MODE=local
DATABASE_URL=
DATABASE_SCHEMA=
LOCAL_DATA_DIR=../../storage/local
LOCAL_DATABASE_FILENAME=content.sqlite3
# PostgreSQL：同时设置 PERSISTENCE_MODE=database、连接地址和可选隔离 schema。
# DATABASE_URL=postgresql+psycopg://ai_comic_user:ai_comic_password@localhost:5432/ai_comic_drama
VERBASCENE_POSTGRES_PASSWORD=verbascene-local
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
STORAGE_ROOT=../../storage
PUBLIC_STORAGE_BASE_URL=http://localhost:8000/storage
FFMPEG_PATH=ffmpeg
PROVIDER_TIMEOUT_SEC=2400
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=mock-llm
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wan2.6-t2i
DASHSCOPE_IMAGE_POLL_INTERVAL_SEC=10
DASHSCOPE_IMAGE_JOB_TIMEOUT_SEC=1200
DASHSCOPE_IMAGE_PROMPT_EXTEND=true
DASHSCOPE_IMAGE_WATERMARK=false
IMAGE_PROVIDER=mock
# Musubi 原生 /generate 服务可使用 qwen_image_musubi；它不是 OpenAI-compatible。
# IMAGE_PROVIDER=qwen_image_musubi
# QWEN_IMAGE_MUSUBI_BASE_URL=http://127.0.0.1:18108
# QWEN_IMAGE_MUSUBI_MODEL=qwen-image-fig-lightning8-v2
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=mock-image
IMAGE_SIZE=1280x720
IMAGE_RESPONSE_FORMAT=b64_json
IMAGE_REFERENCE_TRANSPORT=hybrid
IMAGE_SUPPORTS_REFERENCES=false
# 每个目标每次固定生成 1 个候选；下一版本由用户点击“重生成”创建。
IMAGE_QUALITY=medium
# 可选强制覆盖；留为注释时由 quality 决定：medium=35。
# IMAGE_NUM_INFERENCE_STEPS=35
IMAGE_GUIDANCE_SCALE=4.0
# 仅作为应用侧 seed 派生的命名空间基值；每次生成/重生成会显式发送新 seed。
IMAGE_SEED=
CUSTOM_IMAGE_ENDPOINT=/generate
CUSTOM_IMAGE_OUTPUT_DIR=/tmp/verbascene-provider-output
CUSTOM_IMAGE_PUBLIC_BASE_URL=
# 旧变量兼容保留；新配置请使用 IMAGE_SUPPORTS_REFERENCES。
CUSTOM_IMAGE_SUPPORTS_REFERENCES=false
COMFYUI_FLUX_BASE_URLS=
COMFYUI_FLUX_MODEL=flux1-dev.safetensors
COMFYUI_FLUX_CLIP_L=clip_l.safetensors
COMFYUI_FLUX_T5XXL=t5xxl_fp16.safetensors
COMFYUI_FLUX_VAE=ae.safetensors
COMFYUI_FLUX_WEIGHT_DTYPE=default
COMFYUI_FLUX_CLIP_DEVICE=default
COMFYUI_FLUX_SAMPLER=euler
COMFYUI_FLUX_SCHEDULER=simple
COMFYUI_FLUX_POLL_INTERVAL_SEC=2
COMFYUI_FLUX_JOB_TIMEOUT_SEC=2400
# 前端直接输入的 Provider 密钥保存在该本机文件中；目录不得通过 Web 暴露或提交 Git。
PROVIDER_SECRET_FILE=.runtime/provider-secrets.json
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VIDEO_PROVIDER=mock
VIDEO_API_KEY=
VIDEO_MODEL=mock-video
# 项目级并发；LTX-2.3 服务端会再按 FIFO 排队。
VIDEO_GENERATION_CONCURRENCY=2
# 本地统一任务运行时：剧本并发固定为 1，视频并发最高为 2。
TASK_POLL_INTERVAL_SEC=0.5
TASK_LEASE_SEC=60
TASK_HEARTBEAT_SEC=15
TASK_SHUTDOWN_TIMEOUT_SEC=30
# 方舟 Seedance 2.0。密钥只填环境变量或在模型管理页用密码框保存，禁止提交到 Git。
SEEDANCE2_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE2_API_KEY=
SEEDANCE2_MODEL=doubao-seedance-2-0-260128
SEEDANCE2_API_TIMEOUT_SEC=60
SEEDANCE2_API_POLL_INTERVAL_SEC=10
SEEDANCE2_API_JOB_TIMEOUT_SEC=3600
SEEDANCE2_RESOLUTION=480p
SEEDANCE2_RATIO=16:9
SEEDANCE2_GENERATE_AUDIO=true
SEEDANCE2_WATERMARK=false
LTX23_API_BASE_URL=
LTX23_API_TIMEOUT_SEC=30
LTX23_API_POLL_INTERVAL_SEC=5
LTX23_API_JOB_TIMEOUT_SEC=3600
LTX23_SIZE=1024*576
# LTX23_SEED=42
LTX23_FRAMES=81
LTX23_STEPS=8
LTX23_CFG=1
LTX23_FPS=16
LTX23_STRENGTH=0.78
# MiniMax H3 黑盒网关。推荐在模型管理页选择 minimax_h3_gateway 并保存；
# 内网免 Key 部署可将密钥留空，正式共享部署应配置密钥或网络白名单。
MINIMAX_H3_GATEWAY_BASE_URL=
MINIMAX_H3_GATEWAY_API_KEY=
MINIMAX_H3_GATEWAY_MODEL=auto
MINIMAX_H3_GATEWAY_TIMEOUT_SEC=60
MINIMAX_H3_GATEWAY_POLL_INTERVAL_SEC=5
MINIMAX_H3_GATEWAY_JOB_TIMEOUT_SEC=3600
MINIMAX_H3_GATEWAY_LANDSCAPE_SIZE=1024x576
MINIMAX_H3_GATEWAY_PORTRAIT_SIZE=576x1024
MINIMAX_H3_GATEWAY_STEPS=19
# MINIMAX_H3_GATEWAY_SEED=42
# 保留旧 Wan Adapter 配置，模型管理页可按需回切。
WAN_I2V_API_BASE_URL=
WAN_I2V_API_PROTOCOL=official
WAN_I2V_API_KEY=
WAN_I2V_API_MODE=
WAN_I2V_API_GPU_DEVICES=
WAN_I2V_API_TIMEOUT_SEC=30
WAN_I2V_API_POLL_INTERVAL_SEC=10
WAN_I2V_API_JOB_TIMEOUT_SEC=3600
WAN_I2V_API_RESULT_VARIANT=native
WAN_I2V_IMAGE_TRANSPORT=upload
WAN_I2V_REMOTE_STORAGE_BASE_URL=
WAN_I2V_SIZE=1280*720
# WAN_I2V_SEED=20260720
WAN_I2V_FRAMES=81
WAN_I2V_STEPS=4
WAN_I2V_GUIDANCE=1
WAN_I2V_FPS=16
WAN_I2V_MAX_AREA=921600
WAN_I2V_UPSCALE_1080P=true
WAN_T2V_API_BASE_URL=
WAN_T2V_API_KEY=
WAN_T2V_API_TIMEOUT_SEC=30
WAN_T2V_API_POLL_INTERVAL_SEC=10
WAN_T2V_API_JOB_TIMEOUT_SEC=3600
WAN_T2V_DEFAULT_SIZE=832*480
